generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
	previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // DATABASE_URL="postgresql://LOGIN:PASSWORD@localhost:5432/DATABASE?schema=public"
}

model User {
	id				Int				@id @default(autoincrement())
	name			String
	lastName	String
	age				Int
	email			String		@unique
	country		String
	createAt	DateTime	@default(now())

	posts 		Post[]

	@@map("users")
}


model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
	updateAt	DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int

  @@map("posts")
}